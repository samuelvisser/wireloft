### TEST 2: Clean first page - NO cursor, offset=0, new season ID
# This should return the very latest episodes without stale cursor interference
GET https://middleware-prod.dailywire.com/middleware/v4/getPaginatedEpisodes
    ?slug=the-ben-shapiro-show
    &membershipPlan=ALL_ACCESS
    &orderBy=CreatedAt_DESC
    &pageNumber=1
    &pageSize=20
    &showOffset=0
    &podcastOffset=0
    &showSeasonId=54e348fd-8560-4d9d-a5e0-dd6793cd8d05
Authorization: Bearer {{access_token}}


