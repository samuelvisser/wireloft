{
  "name": "wireloft-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:pro-icons": "vp dev --mode pro-icons",
    "build": "npm run build:free-icons",
    "build:free-icons": "vp check --no-fmt --no-lint && vp build --mode free-icons",
    "build:pro-icons": "vp check --no-fmt --no-lint && vp build --mode pro-icons",
    "preview": "vp preview",
    "check": "vp check --no-fmt",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt . --write",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
