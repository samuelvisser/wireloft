{
  "name": "wireloft-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pro-icons": "vite --mode pro-icons",
    "build": "npm run build:free-icons",
    "validate:free-icons": "node scripts/validate-free-icon-fallbacks.mjs",
    "build:free-icons": "npm run validate:free-icons && tsc --noEmit && vite build --mode free-icons",
    "build:pro-icons": "npm run validate:free-icons && tsc --noEmit && vite build --mode pro-icons",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-jinja": "^6.0.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@hookform/resolvers": "^5.2.1",
    "@tanstack/react-query": "^5.51.1",
    "@uiw/react-codemirror": "^4.25.11",
    "js-sha256": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.27.0",
    "react-select": "^5.10.2",
    "react-switch": "^7.1.0",
    "zod": "^4.1.8"
  },
  "optionalDependencies": {
    "@awesome.me/kit-83fa1ac5a9": "^1.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "7.1.5"
  }
}
