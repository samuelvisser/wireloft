    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "^5.6.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
