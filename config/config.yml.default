# Default WireLoft configuration, seeded into /config/config.yml on first
# container start (see .docker/app/scripts/entrypoint.sh). Safe to edit
# in-place afterwards -- it is only ever copied once, when config.yml does
# not yet exist.
#
# Only list the settings you actually want to override. Anything left out
# of a block below keeps its application default (see
# server/config/src/config/settings/settings.py) -- pydantic-settings merges
# this file's nested blocks with the built-in defaults field-by-field.

crypto:
  # Fallback location for the auto-generated session-signing key, used when
  # neither secretKey nor secretKeyFile is set. Keep this on a persistent
  # volume so logins survive container restarts.
  defaultSecretFile: /config/wl_secret.key

downloadSettings:
  # Directory the '/downloads/' prefix of output templates maps to.
  downloadRoot: /downloads
