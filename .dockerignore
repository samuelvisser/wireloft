.git
.github

# Persistent app state -- never bake this into an image
config/config.yml
config/cookies.txt
data/
downloads/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Node / UI
ui/node_modules/
ui/dist/
# Never send this to the build context; it holds a real credential and is
# only ever passed in as a build secret (see docker-compose.yml).
ui/.npmrc

# Misc
# Include offline unit and UI tests in disposable build stages.
# Manual REST integration files can contain local credentials.
tests/rest/
dev/
*.md
